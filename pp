<script>
(function(){
  // reveal on scroll
  var els = document.querySelectorAll('.reveal');
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, {threshold: 0.08, rootMargin: '0px 0px -60px 0px'});
    els.forEach(function(el){ io.observe(el); });
  } else {
    els.forEach(function(el){ el.classList.add('in'); });
  }

  // active top-level nav link (direct children only — excludes case submenu links)
  var topLinks = document.querySelectorAll('#navLinks > li > a');
  var topSections = Array.prototype.map.call(topLinks, function(a){
    var id = a.getAttribute('href');
    return { el: document.querySelector(id), id: id };
  }).filter(function(s){ return s.el; });
  // include individual case sections so "케이스 스터디" stays active through all 7 cases
  Array.prototype.forEach.call(document.querySelectorAll('#case-01,#case-02,#case-03,#case-04,#case-05,#case-06,#case-07'), function(el){
    topSections.push({ el: el, id: '#cases' });
  });
  topSections.sort(function(a,b){ return a.el.offsetTop - b.el.offsetTop; });

  // fine-grained reading-position waypoints for the floating dock label
  var waypointDefs = [
    ['#top', '인트로'], ['#positioning', '소개'], ['#timeline', '타임라인'],
    ['#cases', '케이스'],
    ['#case-01', 'CASE 01'], ['#case-02', 'CASE 02'],
    ['#case-03', 'CASE 03'], ['#case-04', 'CASE 04'],
    ['#case-05', 'CASE 05'], ['#case-06', 'CASE 06'],
    ['#case-07', 'CASE 07'],
    ['#beyond', '기타 경험'], ['#skills', '스킬'], ['#faq', 'FAQ'], ['#contact', '컨택트']
  ];
  var waypoints = waypointDefs.map(function(d){ return { el: document.querySelector(d[0]), label: d[1] }; }).filter(function(w){ return w.el; });

  var progressFill = document.getElementById('progressFill');
  var dockPosFill = document.getElementById('dockPosFill');
  var dockPosLabel = document.getElementById('dockPosLabel');

  function onScroll(){
    var y = window.scrollY + 120;

    var currentTop = topSections[0];
    topSections.forEach(function(s){ if (s.el.offsetTop <= y) currentTop = s; });
    topLinks.forEach(function(a){
      a.classList.toggle('active', currentTop && a.getAttribute('href') === currentTop.id);
    });

    var currentWp = waypoints[0];
    waypoints.forEach(function(w){ if (w.el.offsetTop <= y) currentWp = w; });
    if (dockPosLabel && currentWp) dockPosLabel.textContent = currentWp.label;

    var doc = document.documentElement;
    var scrollable = (doc.scrollHeight - doc.clientHeight) || 1;
    var pct = Math.min(100, Math.max(0, (window.scrollY / scrollable) * 100));
    if (progressFill) progressFill.style.width = pct + '%';
    if (dockPosFill) dockPosFill.style.width = pct + '%';
  }
  document.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', onScroll);
  window.addEventListener('load', onScroll);
  onScroll();

  // dock jump buttons
  var jumpTop = document.getElementById('jumpTop');
  var jumpBottom = document.getElementById('jumpBottom');
  if (jumpTop) jumpTop.addEventListener('click', function(){
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
  if (jumpBottom) jumpBottom.addEventListener('click', function(){
    window.scrollTo({ top: document.documentElement.scrollHeight, behavior: 'smooth' });
  });

  // mailto fallback: copy address so it's useful even without a mail client
  var toast = document.getElementById('toast');
  var toastTimer;
  function showToast(msg){
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function(){ toast.classList.remove('show'); }, 5000);
  }
  document.querySelectorAll('.mailto-copy').forEach(function(a){
    a.addEventListener('click', function(e){
      // preventDefault: a sandboxed preview can silently swallow mailto: navigation
      // entirely (no dialog, no error) — never rely on it, always show the address instead.
      if (e && e.preventDefault) e.preventDefault();
      var addr = a.getAttribute('href').replace('mailto:', '').split('?')[0];
      showToast('이메일: ' + addr + ' (직접 복사해주세요)');
      try {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(addr).catch(function(){});
        }
      } catch(err) {}
    });
  });
})();
</script>
