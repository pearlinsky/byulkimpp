<style>
  @font-face {
    font-family: 'Pretendard';
    font-weight: 400;
    font-display: swap;
    src: url(data:font/woff2;base64,) format('woff2');
  }
  @font-face {
    font-family: 'Pretendard';
    font-weight: 600;
    font-display: swap;
    src: url(data:font/woff2;base64,) format('woff2');
  }
  @font-face {
    font-family: 'Pretendard';
    font-weight: 800;
    font-display: swap;
    src: url(data:font/woff2;base64,) format('woff2');
  }

  :root {
    --bg: #f5f5f0;
    --surface: #ffffff;
    --surface-2: #eeede6;
    --ink: #16181b;
    --ink-soft: #53585f;
    --ink-faint: #83878d;
    --line: #dcdbd2;
    --line-strong: #c7c6bb;
    --accent: #17509e;
    --accent-ink: #ffffff;
    --accent-soft: #e7eef8;
    --accent-soft-line: #c7d8ef;
    --confirmed: #b4491f;
    --shadow: 0 1px 2px rgba(22,24,27,0.04), 0 8px 24px -12px rgba(22,24,27,0.12);
    --radius-s: 3px;
    --radius-m: 6px;
    --mono: ui-monospace, "SF Mono", "Menlo", "Consolas", monospace;
    --sans: 'Pretendard', -apple-system, "Malgun Gothic", sans-serif;
    color-scheme: light;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
    word-break: keep-all;
    overflow-wrap: break-word;
  }

  ::selection { background: var(--accent); color: var(--accent-ink); }

  a { color: inherit; }
  h1, h2, h3, h4 { margin: 0; text-wrap: balance; font-weight: 800; letter-spacing: -0.01em; }
  p { margin: 0; }
  img { max-width: 100%; display: block; }
  .tabular { font-variant-numeric: tabular-nums; }

  .wrap {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4.5vw, 56px);
  }
  .prose { max-width: 640px; }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .eyebrow::before {
    content: "";
    width: 16px;
    height: 1px;
    background: var(--accent);
    display: inline-block;
  }
  .eyebrow.muted { color: var(--ink-faint); }
  .eyebrow.muted::before { background: var(--ink-faint); }

  /* ---------- NAV ---------- */
  .nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4.5vw, 56px);
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-links {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0; padding: 0;
    overflow: visible;
  }
  .nav-links > li { position: relative; display: flex; }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    padding: 8px 12px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-s);
    transition: color .15s ease, background .15s ease;
  }
  .nav-links a:hover { color: var(--ink); background: var(--surface-2); }
  .nav-links a.active { color: var(--accent); }
  @media (max-width: 900px) {
    .nav-links { overflow-x: auto; scrollbar-width: none; }
    .nav-links::-webkit-scrollbar { display: none; }
  }

  /* case submenu (hover / focus reveal) */
  .has-sub > a::after { content: ""; display: inline-block; width: 5px; height: 5px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); margin-left: 7px; opacity: .55; }
  .submenu {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: 300px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow);
    padding: 8px;
    display: grid;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .15s ease, transform .15s ease, visibility .15s;
    z-index: 110;
  }
  .has-sub:hover .submenu,
  .has-sub:focus-within .submenu {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
  }
  .submenu a {
    display: flex; align-items: baseline; gap: 8px;
    padding: 9px 10px; border-radius: var(--radius-s);
    font-size: 13px; font-weight: 600; color: var(--ink);
    white-space: normal;
  }
  .submenu a:hover { background: var(--accent-soft); color: var(--accent); }
  .submenu a:hover .sm-n { color: var(--accent); }
  .submenu .sm-n { font-family: var(--mono); font-size: 11px; color: var(--ink-faint); flex-shrink: 0; }
  .submenu .sm-t { margin-left: auto; font-size: 11.5px; font-weight: 500; color: var(--ink-faint); white-space: nowrap; padding-left: 8px; }
  @media (max-width: 900px) {
    .submenu { position: static; opacity: 1; visibility: visible; pointer-events: auto; transform: none; display: none; width: auto; box-shadow: none; border: none; padding: 0; }
    .has-sub { flex-direction: column; }
  }

  .progress-track {
    position: absolute; left: 0; right: 0; bottom: -1px; height: 2px;
    background: transparent;
  }
  .progress-fill {
    height: 100%; width: 0%;
    background: var(--accent);
    transition: width .1s linear;
  }
  .nav-cta-group {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }
  .nav-cta {
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: var(--radius-s);
    background: var(--ink);
    color: var(--bg);
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid var(--ink);
    transition: opacity .15s ease, background .15s ease, color .15s ease;
  }
  .nav-cta:hover { opacity: .82; }
  .nav-cta.ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--line-strong);
  }
  .nav-cta.ghost:hover { background: var(--surface-2); opacity: 1; }
  @media (max-width: 560px) {
    .nav-cta.ghost { display: none; }
  }

  main { padding-top: 60px; }

  /* ---------- HERO ---------- */
  .hero {
    padding: clamp(56px, 9vw, 108px) 0 clamp(40px, 6vw, 64px);
    position: relative;
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    padding: 6px 12px 6px 10px;
    border-radius: 100px;
    margin-bottom: 28px;
  }
  .hero-status .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #3fa35a;
    box-shadow: 0 0 0 3px color-mix(in srgb, #3fa35a 22%, transparent);
    flex-shrink: 0;
  }
  .hero h1 {
    font-size: clamp(32px, 5.4vw, 58px);
    line-height: 1.14;
    max-width: 22ch;
  }
  .hero .lede {
    margin-top: 24px;
    font-size: clamp(15.5px, 1.6vw, 18px);
    color: var(--ink-soft);
    max-width: 640px;
    line-height: 1.75;
  }
  .hero .lede b { color: var(--ink); font-weight: 700; }
  .hero-actions {
    margin-top: 32px;
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius-s);
    font-weight: 700;
    font-size: 14.5px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform .15s ease, opacity .15s ease, background .15s ease;
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--ink); color: var(--bg); }
  .btn-primary:hover { opacity: .85; }
  .btn-ghost { background: transparent; color: var(--ink); border-color: var(--line-strong); }
  .btn-ghost:hover { background: var(--surface); border-color: var(--ink-faint); }
  .btn.sm { padding: 8px 14px; font-size: 13px; }

  .doc-cta {
    margin: 18px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--surface);
  }
  .doc-cta-info { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .doc-cta-icon {
    flex-shrink: 0; width: 36px; height: 36px; border-radius: var(--radius-s);
    background: var(--accent-soft); color: var(--accent); border: 1px solid var(--accent-soft-line);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono); font-size: 10.5px; font-weight: 700; letter-spacing: -0.02em;
  }
  .doc-cta-name { font-size: 15.5px; font-weight: 700; }
  .doc-cta-meta { font-size: 13.5px; color: var(--ink-soft); margin-top: 4px; }
  .doc-cta-actions { display: flex; gap: 10px; flex-shrink: 0; }

  .stat-row {
    margin-top: clamp(44px, 6vw, 68px);
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .stat-tile {
    padding: 22px clamp(14px, 2vw, 24px);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stat-num {
    font-family: var(--mono);
    font-weight: 800;
    font-size: clamp(24px, 3.2vw, 36px);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .stat-cap { margin-top: 8px; font-size: 12.5px; color: var(--ink-soft); line-height: 1.5; }
  .stat-cap b { color: var(--ink); font-weight: 600; }
  @media (max-width: 720px) {
    .stat-row { grid-template-columns: repeat(2, 1fr); }
  }

  /* ---------- SECTION shell ---------- */
  section { padding: clamp(56px, 8vw, 96px) 0; }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 52px);
    border-bottom: 1px solid var(--line);
    padding-bottom: 20px;
  }
  .section-head h2 {
    font-size: clamp(24px, 3vw, 34px);
    margin-top: 10px;
  }
  .section-idx {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
    white-space: nowrap;
    padding-bottom: 8px;
  }
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity .6s cubic-bezier(.2,.7,.2,1), transform .6s cubic-bezier(.2,.7,.2,1);
  }
  .reveal.in { opacity: 1; transform: translateY(0); }

  /* ---------- POSITIONING ---------- */
  .pos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .pos-card { background: var(--surface); padding: clamp(22px, 3vw, 32px); }
  .pos-card .num { font-family: var(--mono); font-size: 12px; color: var(--accent); font-weight: 700; letter-spacing: .06em; }
  .pos-card h3 { font-size: 19px; margin-top: 14px; line-height: 1.4; }
  .pos-card p { margin-top: 12px; font-size: 14.5px; color: var(--ink-soft); line-height: 1.7; }
  @media (max-width: 800px) { .pos-grid { grid-template-columns: 1fr; } }

  /* ---------- TIMELINE ---------- */
  .tl { position: relative; }
  .tl-item {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: 20px;
    align-items: start;
    padding: 20px 0;
    border-top: 1px solid var(--line);
    position: relative;
  }
  .tl-item:last-child { border-bottom: 1px solid var(--line); }
  .tl-date {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink-faint);
    padding-top: 3px;
  }
  .tl-body h4 { font-size: 16.5px; font-weight: 700; }
  .tl-body .role { color: var(--ink-soft); font-size: 14px; margin-top: 4px; }
  .tl-result {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    text-align: right;
    white-space: nowrap;
    padding-top: 3px;
  }
  @media (max-width: 640px) {
    .tl-item { grid-template-columns: 1fr; gap: 6px; }
    .tl-result { text-align: left; }
  }
  .tl-note {
    margin-top: 20px;
    font-size: 13px;
    color: var(--ink-faint);
    border-left: 2px solid var(--line-strong);
    padding-left: 12px;
  }
  .tl-note a { color: var(--accent); text-decoration: none; border-bottom: 1px dotted var(--accent); }

  /* ---------- CASE INDEX ---------- */
  .case-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .case-card {
    background: var(--surface);
    padding: 24px;
    text-decoration: none;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 168px;
    transition: background .15s ease;
  }
  .case-card:hover { background: var(--surface-2); }
  .case-card-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .case-card .cnum { font-family: var(--mono); font-size: 12px; color: var(--ink-faint); }
  .case-card .cmetric {
    font-family: var(--mono); font-weight: 800; font-size: 22px; color: var(--accent);
    white-space: nowrap;
  }
  .case-card h4 { font-size: 18px; }
  .case-card .ctag { font-size: 13px; color: var(--ink-soft); margin-top: auto; }
  @media (max-width: 720px) { .case-grid { grid-template-columns: 1fr; } }

  /* ---------- CASE STUDY ---------- */
  .case {
    padding: clamp(48px, 7vw, 80px) 0;
    border-top: 1px solid var(--line);
  }
  .case-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    align-items: end;
    margin-bottom: clamp(28px, 4vw, 44px);
  }
  .case-tag {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: .06em;
  }
  .case-title { font-size: clamp(24px, 3.4vw, 36px); margin-top: 8px; }
  .case-meta {
    font-size: 13px;
    color: var(--ink-soft);
    text-align: right;
    line-height: 1.6;
  }
  .case-hl {
    font-family: var(--mono);
    font-weight: 800;
    font-size: clamp(30px, 4.4vw, 46px);
    color: var(--accent);
    line-height: 1;
    white-space: nowrap;
  }

  .phase {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 28px;
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .phase:first-of-type { border-top: 1px solid var(--line); }
  .phase-label {
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    color: var(--ink-faint);
    letter-spacing: .04em;
    padding-top: 3px;
  }
  .phase-body h3 { font-size: 20px; margin-bottom: 12px; }
  .phase-body p { color: var(--ink-soft); font-size: 15px; line-height: 1.75; max-width: 640px; }
  .phase-body p + p { margin-top: 10px; }
  .phase-body b { color: var(--ink); font-weight: 700; }
  @media (max-width: 700px) {
    .phase { grid-template-columns: 1fr; gap: 10px; }
  }

  .metric-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(140px, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin: 18px 0;
    overflow-x: auto;
  }
  .metric-strip.dark { background: var(--ink); border-color: var(--ink); }
  .metric {
    background: var(--surface);
    padding: 18px 18px 16px;
  }
  .metric-strip.dark .metric { background: var(--ink); }
  .metric-num {
    font-family: var(--mono); font-weight: 800; font-size: clamp(20px, 2.6vw, 27px);
    color: var(--ink);
  }
  .metric-strip.dark .metric-num { color: var(--bg); }
  .metric-cap { font-size: 12px; color: var(--ink-soft); margin-top: 6px; line-height: 1.5; }
  .metric-strip.dark .metric-cap { color: color-mix(in srgb, var(--bg) 65%, transparent); }
  .metric-sub { font-size: 11px; color: var(--ink-faint); margin-top: 2px; }

  .caveat {
    margin-top: 18px;
    display: flex;
    gap: 10px;
    padding: 14px 16px;
    max-width: 640px;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--confirmed);
    border-radius: var(--radius-s);
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  .caveat b { color: var(--confirmed); font-weight: 700; white-space: nowrap; }

  .shots {
    display: grid;
    gap: 16px;
    margin: 8px 0 4px;
  }
  .shots.n2 { grid-template-columns: repeat(2, 1fr); }
  .shots.n3 { grid-template-columns: repeat(3, 1fr); }
  .shots.n4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 720px) { .shots.n3, .shots.n4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .shots.n2, .shots.n3, .shots.n4 { grid-template-columns: 1fr; } }
  figure { margin: 0; }
  .shot-frame {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .shot-frame img { width: 100%; height: auto; display: block; }
  figcaption {
    margin-top: 8px;
    font-size: 12px;
    color: var(--ink-faint);
    text-align: center;
    line-height: 1.5;
  }

  .wide-shot { border: 1px solid var(--line); border-radius: var(--radius-m); overflow: hidden; box-shadow: var(--shadow); background: var(--surface); }
  .wide-shot img { width: 100%; }

  .shot-toggle { margin: 18px 0; border: 1px solid var(--line); border-radius: var(--radius-m); background: var(--surface); }
  .shot-toggle summary {
    display: flex; align-items: center; gap: 10px;
    padding: 14px 16px; cursor: pointer; list-style: none;
    font-size: 13.5px; font-weight: 700; color: var(--ink);
  }
  .shot-toggle summary::-webkit-details-marker { display: none; }
  .shot-toggle summary .stog-icon {
    width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
    border: 1px solid var(--line-strong); display: flex; align-items: center; justify-content: center;
    font-family: var(--mono); font-size: 13px; color: var(--ink-faint); transition: transform .2s ease;
  }
  .shot-toggle[open] summary .stog-icon { transform: rotate(45deg); color: var(--accent); border-color: var(--accent); }
  .shot-toggle summary .stog-hint { font-weight: 500; color: var(--ink-faint); font-size: 12px; margin-left: auto; }
  .shot-toggle .stog-body { padding: 0 16px 18px; }
